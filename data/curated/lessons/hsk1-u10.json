          { "zh": "我给妈妈打电话。", "vi": "Tôi gọi điện cho mẹ." }
        ]
      },
      "sentences": [
        { "zh": "这是谁的手机？", "vi": "Đây là điện thoại của ai?", "blank": "谁" },
        { "zh": "我的电脑是新的。", "vi": "Máy tính của tôi là máy mới.", "blank": "电脑" },
        { "zh": "晚上给我打电话吧。", "vi": "Tối gọi điện cho tôi nhé.", "blank": "打电话" },
        { "zh": "喂，你在哪儿？", "vi": "A lô, bạn đang ở đâu?", "blank": "喂" }
      ],
      "speak": ["喂，你是谁？", "我给妈妈打电话。"]
    }
