          { "zh": "她喜欢唱歌。", "vi": "Cô ấy thích hát." }
        ]
      },
      "sentences": [
        { "zh": "这个电影很好看。", "vi": "Bộ phim này rất hay.", "blank": "好看" },
        { "zh": "孩子们在外边玩。", "vi": "Bọn trẻ đang chơi bên ngoài.", "blank": "玩" },
        { "zh": "我喜欢猫，不喜欢狗。", "vi": "Tôi thích mèo, không thích chó.", "blank": "狗" },
        { "zh": "我们唱歌吧。", "vi": "Chúng ta hát đi.", "blank": "唱" }
      ],
      "speak": ["这个歌很好听。", "北京很好玩儿。"]
    },
