      "grammar": {
        "pattern": "…了 (thay đổi trạng thái)",
        "explanationVi": "了 ở cuối câu báo một tình huống mới / sự thay đổi: 下雨了 (trời mưa rồi — trước đó chưa mưa), 天气冷了 (trời lạnh rồi). Khác với 了 sau động từ (hành động đã xong). 会 + động từ còn có nghĩa “sẽ”: 明天会下雨.",
        "examples": [
          { "zh": "下雨了！", "vi": "Trời mưa rồi!" },
          { "zh": "天气热了。", "vi": "Trời nóng lên rồi." },
          { "zh": "北京下雪了。", "vi": "Bắc Kinh có tuyết rồi." }
        ]
      },
      "sentences": [
        { "zh": "今天天气怎么样？", "vi": "Hôm nay thời tiết thế nào?", "blank": "天气" },
        { "zh": "外边太冷了。", "vi": "Bên ngoài lạnh quá.", "blank": "冷" },
        { "zh": "明天会下雨。", "vi": "Ngày mai trời sẽ mưa.", "blank": "下雨" },
        { "zh": "今天很热。", "vi": "Hôm nay rất nóng.", "blank": "热" }
      ],
      "speak": ["下雨了！", "今天天气怎么样？"]
    },
    {
      "id": "hsk1-u10-l2",
      "title": "Tôi bị ốm",
      "words": ["病", "生病", "看病", "医生", "医院", "怎么样"],
      "grammar": {
        "pattern": "…，怎么样？",
        "explanationVi": "怎么样 đứng cuối câu để hỏi tình trạng hoặc xin ý kiến: 你怎么样？ (bạn thế nào?), 这个菜怎么样？ Đề nghị: 我们去医院，怎么样？ (… được không?).",
        "examples": [
          { "zh": "你现在怎么样？", "vi": "Bây giờ bạn thế nào rồi?" },
          { "zh": "我生病了，要去医院。", "vi": "Tôi bị ốm, phải đi bệnh viện." },
          { "zh": "明天去看病，怎么样？", "vi": "Mai đi khám bệnh, được không?" }
        ]
      },
      "sentences": [
        { "zh": "他是医生。", "vi": "Anh ấy là bác sĩ.", "blank": "医生" },
        { "zh": "我妈妈生病了。", "vi": "Mẹ tôi bị ốm rồi.", "blank": "生病", "notOptions": ["病"] },
        { "zh": "医院在哪儿？", "vi": "Bệnh viện ở đâu?", "blank": "医院" },
        { "zh": "你觉得怎么样？", "vi": "Bạn thấy thế nào?", "blank": "怎么样", "notOptions": ["怎么"] }
      ],
      "speak": ["你现在怎么样？", "我生病了，要去医院。"]
    },
    {
      "id": "hsk1-u10-l3",
      "title": "Xem phim, nghe nhạc",
      "words": ["看", "见", "看见", "听", "听见", "电视", "电影", "电影院"],
      "grammar": {
        "pattern": "看 / 听 + 见",
        "explanationVi": "看 = nhìn, xem (hành động); 看见 = nhìn thấy (kết quả). 听 = nghe; 听见 = nghe thấy. Phủ định kết quả dùng 没: 我没看见他. 见 = gặp: 明天见！",
        "examples": [
          { "zh": "我看见他了。", "vi": "Tôi nhìn thấy anh ấy rồi." },
          { "zh": "你听见了吗？", "vi": "Bạn nghe thấy chưa?" },
          { "zh": "我们去电影院看电影吧。", "vi": "Chúng ta đi rạp xem phim nhé." }
        ]
      },
      "sentences": [
        { "zh": "我喜欢看电视。", "vi": "Tôi thích xem tivi.", "blank": "电视" },
        { "zh": "我没听见。", "vi": "Tôi không nghe thấy.", "blank": "听见", "notOptions": ["看见"] },
        { "zh": "你在听什么？", "vi": "Bạn đang nghe gì?", "blank": "听" },
        { "zh": "明天见！", "vi": "Mai gặp nhé!", "blank": "见" }
      ],
      "speak": ["我看见他了。", "你听见了吗？"]
    },
    {
