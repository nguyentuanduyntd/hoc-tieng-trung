      "grammar": {
        "pattern": "想 + động từ",
        "explanationVi": "想 + động từ = muốn làm gì (mong muốn, nói nhẹ nhàng): 我想吃饺子. Phủ định: 不想: 我不想喝牛奶. 想 + người = nhớ ai: 我想妈妈.",
        "examples": [
          { "zh": "我想吃饺子。", "vi": "Tôi muốn ăn sủi cảo." },
          { "zh": "你想喝什么？", "vi": "Bạn muốn uống gì?" },
          { "zh": "我不想吃面包。", "vi": "Tôi không muốn ăn bánh mì." }
        ]
      },
      "sentences": [
        { "zh": "早上我吃面包，喝牛奶。", "vi": "Buổi sáng tôi ăn bánh mì, uống sữa.", "blank": "牛奶" },
        { "zh": "我想吃包子。", "vi": "Tôi muốn ăn bánh bao.", "blank": "想", "notOptions": ["要"] },
        { "zh": "妈妈做了很多饺子。", "vi": "Mẹ đã làm rất nhiều sủi cảo.", "blank": "饺子" },
        { "zh": "我不想吃鸡蛋。", "vi": "Tôi không muốn ăn trứng.", "blank": "鸡蛋" }
      ],
      "speak": ["我想吃饺子。", "我不想吃面包。"]
    },
