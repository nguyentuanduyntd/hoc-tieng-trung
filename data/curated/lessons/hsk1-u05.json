        { "zh": "中午我们在学校吃午饭。", "vi": "Buổi trưa chúng tôi ăn trưa ở trường.", "blank": "午饭" },
        { "zh": "我很喜欢吃水果。", "vi": "Tôi rất thích ăn hoa quả.", "blank": "水果" }
      ],
      "speak": ["太好吃了！", "这个苹果太大了。"]
